@model IEnumerable<Course>
@{
    Layout = "_AdminLayout";
}

<div class="admin-section-header">
  <span></span>
  <a href="/admin/courses/create" class="admin-btn admin-btn--primary">
    <i class="bi bi-plus me-1"></i>New Course
  </a>
</div>

<div class="table-responsive">
  <table class="table table-bordered table-hover admin-table">
    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th class="admin-col-lg">Category</th>
        <th class="admin-col-md">Year Levels</th>
        <th class="admin-col-md">Actions</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var item in Model)
      {
        <tr>
          <td>@item.Name</td>
          <td>@item.Category</td>
          <td>@item.YearLevels</td>
          <td>
            <a href="/admin/courses/edit/@item.Id" class="admin-btn admin-btn--secondary me-1">Edit</a>
            <a href="/admin/courses/delete/@item.Id" class="admin-btn admin-btn--danger">Delete</a>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>
