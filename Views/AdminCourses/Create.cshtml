@model Course
@{
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
  <div class="col-lg-7">
    <form asp-controller="AdminCourses" asp-action="Create" method="post">
      <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
      </div>
      <div class="mb-3">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category" class="form-select">
          <option value="">-- Select --</option>
          <option>Core</option>
          <option>Elective</option>
          <option>Advanced Elective</option>
          <option>Other</option>
          <option>Extra-Curricular</option>
        </select>
        <span asp-validation-for="Category" class="text-danger small"></span>
      </div>
      <div class="mb-3">
        <label asp-for="YearLevels" class="form-label"></label>
        <input asp-for="YearLevels" class="form-control" placeholder="e.g. Years 1–7" />
        <span asp-validation-for="YearLevels" class="text-danger small"></span>
      </div>
      <div class="mb-4">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
      </div>
      <div class="d-flex gap-2">
        <button type="submit" class="admin-btn admin-btn--primary">Save</button>
        <a href="/admin/courses" class="admin-btn admin-btn--secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
