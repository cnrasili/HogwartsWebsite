@model HomeViewModel

<!-- Carousel + News -->
<section class="content-section">
  <div class="container-fluid px-4">
    <div class="row g-0">

      <!-- Carousel -->
      <div class="col-lg-8">
        <div class="carousel-wrapper">
          <div class="carousel-binding" aria-hidden="true"></div>
          <div id="mainCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-indicators">
              <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
              <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
              <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
              <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="3" aria-label="Slide 4"></button>
            </div>
            <div class="carousel-inner">
              <div class="carousel-item active">
                <img src="~/assets/images/hogwarts-castle.jpg" class="d-block w-100 carousel-img" alt="Hogwarts castle" />
                <div class="carousel-caption slide-caption">
                  <h5 class="slide-caption-title">Welcome to Hogwarts</h5>
                  <p class="slide-caption-text">Britain's finest school of magic, nestled in the Scottish Highlands since 990 A.D.</p>
                </div>
              </div>
              <div class="carousel-item">
                <img src="~/assets/images/the-great-hall.png" class="d-block w-100 carousel-img" alt="The Great Hall" />
                <div class="carousel-caption slide-caption">
                  <h5 class="slide-caption-title">The Great Hall</h5>
                  <p class="slide-caption-text">Where students gather for feasts, ceremonies, and the annual Sorting.</p>
                </div>
              </div>
              <div class="carousel-item">
                <img src="~/assets/images/quidditch-pitch.webp" class="d-block w-100 carousel-img" alt="Quidditch pitch" />
                <div class="carousel-caption slide-caption">
                  <h5 class="slide-caption-title">Quidditch Pitch</h5>
                  <p class="slide-caption-text">Home to inter-house Quidditch matches throughout the academic year.</p>
                </div>
              </div>
              <div class="carousel-item">
                <img src="~/assets/images/students-in-class.webp" class="d-block w-100 carousel-img" alt="Students in class" />
                <div class="carousel-caption slide-caption">
                  <h5 class="slide-caption-title">Academic Excellence</h5>
                  <p class="slide-caption-text">Seven years of magical study across core subjects and electives.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="carousel-tear" aria-hidden="true"></div>
        </div>
      </div>

      <!-- News panel — dynamic from DB -->
      <div class="col-lg-4">
        <div class="news-panel">
          <div class="news-panel-header">NEWS</div>
          @foreach (var item in Model.LatestAnnouncements)
          {
            var newsImg = item.Category switch
            {
                "Sports"   => "quidditch-pitch.webp",
                "Academic" => "students-in-class.webp",
                "Events"   => "the-great-hall.png",
                _          => "ministry-of-magic-logo.webp"
            };
            <a asp-controller="Announcements" asp-action="Index" class="news-item">
              <img src="~/assets/images/@newsImg" alt="@item.Title" class="news-thumb" />
              <div class="news-item-body">
                <p class="news-item-title">@item.Title</p>
                <span class="news-item-date"><i class="bi bi-calendar3"></i> @item.PublishedDate.ToString("dd-MM-yyyy")</span>
              </div>
            </a>
          }
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Quick links -->
<section class="quick-links-section">
  <div class="quick-links-bar">
    <span>Quick Links</span>
  </div>
  <div class="container-fluid px-4">
    <div class="row g-0">

      <div class="col-md-4">
        <div class="quick-link-group">
          <div class="quick-link-heading">
            <i class="bi bi-chevron-right"></i> Apply for Admission
          </div>
          <ul class="quick-link-sublist">
            <li><a asp-controller="Admissions" asp-action="Index" asp-fragment="requirements">Entry Requirements</a></li>
            <li><a asp-controller="Admissions" asp-action="Index" asp-fragment="process">The Owl Letter</a></li>
            <li><a asp-controller="Admissions" asp-action="Index" asp-fragment="requirements">What to Bring</a></li>
          </ul>
        </div>
      </div>

      <div class="col-md-4">
        <div class="quick-link-group">
          <div class="quick-link-heading">
            <i class="bi bi-chevron-right"></i> Upcoming Events
          </div>
          <ul class="quick-link-sublist">
            @foreach (var ev in Model.UpcomingEvents)
            {
              <li><a asp-controller="Events" asp-action="Index">@ev.Title</a></li>
            }
          </ul>
        </div>
      </div>

      <div class="col-md-4">
        <div class="quick-link-group">
          <div class="quick-link-heading">
            <i class="bi bi-chevron-right"></i> School Houses
          </div>
          <ul class="quick-link-sublist">
            <li><a asp-controller="Houses" asp-action="Index" asp-fragment="gryffindor">Gryffindor</a></li>
            <li><a asp-controller="Houses" asp-action="Index" asp-fragment="slytherin">Slytherin</a></li>
            <li><a asp-controller="Houses" asp-action="Index" asp-fragment="ravenclaw">Ravenclaw</a></li>
            <li><a asp-controller="Houses" asp-action="Index" asp-fragment="hufflepuff">Hufflepuff</a></li>
          </ul>
        </div>
      </div>

    </div>
  </div>
</section>
