<!-- Error page -->
<section class="page-hero">
  <div class="container-fluid px-4">
    <h1 class="page-hero-title">Something Went Wrong</h1>
    <p class="page-hero-subtitle">An unexpected error has occurred</p>
  </div>
</section>

<section class="inner-section">
  <div class="container text-center">
    <div class="error-page">
      <p class="error-code">500</p>
      <p class="error-message">The castle enchantments are experiencing some turbulence. Please try again shortly, or return to the home page.</p>
      <a asp-controller="Home" asp-action="Index" class="btn-primary-hogwarts">Return to Home Page</a>
    </div>
  </div>
</section>
