@{
    var _ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] — Hogwarts Admin</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body class="admin-body">
  <div class="admin-wrapper">

    <aside class="admin-sidebar">
      <div class="admin-sidebar-brand">
        <img src="~/assets/images/hogwarts-crest.png" alt="Hogwarts" />
        <span>Admin Panel</span>
      </div>
      <nav class="admin-nav">
        <a href="/admin" class="admin-nav-link @(_ctrl == "Admin" ? "active" : "")">
          <i class="bi bi-grid me-2"></i>Dashboard
        </a>
        <a href="/admin/announcements" class="admin-nav-link @(_ctrl == "AdminAnnouncements" ? "active" : "")">
          <i class="bi bi-megaphone me-2"></i>Announcements
        </a>
        <a href="/admin/events" class="admin-nav-link @(_ctrl == "AdminEvents" ? "active" : "")">
          <i class="bi bi-calendar-event me-2"></i>Events
        </a>
        <a href="/admin/staff" class="admin-nav-link @(_ctrl == "AdminStaff" ? "active" : "")">
          <i class="bi bi-people me-2"></i>Staff
        </a>
        <a href="/admin/courses" class="admin-nav-link @(_ctrl == "AdminCourses" ? "active" : "")">
          <i class="bi bi-book me-2"></i>Courses
        </a>
      </nav>
    </aside>

    <div class="admin-main">
      <header class="admin-topbar">
        <span class="admin-topbar-title">@ViewData["Title"]</span>
        <div class="d-flex align-items-center gap-3">
          <a asp-controller="Home" asp-action="Index" target="_blank" class="admin-topbar-link">
            <i class="bi bi-box-arrow-up-right me-1"></i>View Site
          </a>
          <form asp-controller="AdminAccount" asp-action="Logout" method="post" class="mb-0">
            <button type="submit" class="admin-topbar-link">
              <i class="bi bi-box-arrow-right me-1"></i>Logout
            </button>
          </form>
        </div>
      </header>
      <main class="admin-content">
        @RenderBody()
      </main>
    </div>

  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
