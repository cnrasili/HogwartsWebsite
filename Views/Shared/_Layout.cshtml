<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] — Hogwarts School of Witchcraft and Wizardry</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>

  <!-- Top bar -->
  <div class="top-bar">
    <div class="container-fluid px-4">
      <div class="d-flex justify-content-between align-items-center">
        <span class="top-bar-contact">
          <i class="bi bi-envelope me-1"></i> headmaster@hogwarts.wiz
        </span>
        <nav class="top-bar-nav">
          <a asp-controller="Home" asp-action="Index"><i class="bi bi-house me-1"></i>Home</a>
          <a asp-controller="Admissions" asp-action="Index"><i class="bi bi-mortarboard me-1"></i>Admissions</a>
          <a asp-controller="Announcements" asp-action="Index"><i class="bi bi-megaphone me-1"></i>Notices</a>
        </nav>
      </div>
    </div>
  </div>

  <!-- Site header -->
  <header class="site-header">
    <div class="container-fluid px-4">
      <div class="d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
          <img src="~/assets/images/hogwarts-crest.png" alt="Hogwarts School seal" class="header-crest" />
          <div class="header-identity">
            <span class="header-location">SCOTLAND / SCOTTISH HIGHLANDS</span>
            <p class="header-school-name">Hogwarts School of Witchcraft and Wizardry</p>
          </div>
        </div>
        @RenderSection("HeaderPortrait", required: false)
      </div>
    </div>
  </header>

  <!-- Main navbar -->
  @{
    var _ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
  }
  <nav class="navbar navbar-expand-lg main-nav">
    <div class="container-fluid px-4">
      <a asp-controller="Home" asp-action="Index" class="nav-home-icon" aria-label="Home">
        <i class="bi bi-house-fill"></i>
      </a>
      <button class="navbar-toggler ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav">

          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle @(_ctrl == "About" ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Our School</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" asp-controller="About" asp-action="Index">About &amp; History</a></li>
              <li><a class="dropdown-item" asp-controller="About" asp-action="Index" asp-fragment="timeline">Historical Timeline</a></li>
              <li><a class="dropdown-item" asp-controller="About" asp-action="Index" asp-fragment="founders">The Four Founders</a></li>
              <li><a class="dropdown-item" asp-controller="About" asp-action="Index" asp-fragment="headmasters">Notable Headmasters</a></li>
              <li><a class="dropdown-item" asp-controller="About" asp-action="Index" asp-fragment="castle">The Castle</a></li>
            </ul>
          </li>

          <li class="nav-item">
            <a class="nav-link @(_ctrl == "Houses" ? "active" : "")" asp-controller="Houses" asp-action="Index">Houses</a>
          </li>

          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle @(_ctrl == "Staff" ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Academic Staff</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" asp-controller="Staff" asp-action="Index">All Staff</a></li>
              <li><a class="dropdown-item" asp-controller="Staff" asp-action="Index" asp-fragment="headmaster">Headmaster</a></li>
              <li><a class="dropdown-item" asp-controller="Staff" asp-action="Index" asp-fragment="professors">Professors</a></li>
            </ul>
          </li>

          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle @(_ctrl == "Courses" ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Courses</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" asp-controller="Courses" asp-action="Index">All Courses</a></li>
              <li><a class="dropdown-item" asp-controller="Courses" asp-action="Index" asp-fragment="core">Core Subjects</a></li>
              <li><a class="dropdown-item" asp-controller="Courses" asp-action="Index" asp-fragment="electives">Elective Subjects</a></li>
              <li><a class="dropdown-item" asp-controller="Courses" asp-action="Index" asp-fragment="electives-advanced">Advanced Electives</a></li>
              <li><a class="dropdown-item" asp-controller="Courses" asp-action="Index" asp-fragment="other">Other Classes</a></li>
              <li><a class="dropdown-item" asp-controller="Courses" asp-action="Index" asp-fragment="extracurricular">Extra-Curricular</a></li>
            </ul>
          </li>

          <li class="nav-item">
            <a class="nav-link @(_ctrl == "Admissions" ? "active" : "")" asp-controller="Admissions" asp-action="Index">Admissions</a>
          </li>

          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle @(_ctrl == "Announcements" ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Announcements</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" asp-controller="Announcements" asp-action="Index">Latest Notices</a></li>
              <li><a class="dropdown-item" asp-controller="Announcements" asp-action="Index" asp-fragment="archive">Archive</a></li>
            </ul>
          </li>

          <li class="nav-item">
            <a class="nav-link @(_ctrl == "Events" ? "active" : "")" asp-controller="Events" asp-action="Index">Events</a>
          </li>

        </ul>
      </div>
    </div>
  </nav>

  <main>
    @RenderBody()
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="container">
      <div class="row gy-4">

        <div class="col-md-4">
          <h6 class="footer-heading">Hogwarts School</h6>
          <p class="footer-text">Providing magical education since 990 A.D. Located in the Scottish Highlands.</p>
        </div>

        <div class="col-md-4">
          <h6 class="footer-heading">Quick Links</h6>
          <ul class="footer-links list-unstyled">
            <li><a asp-controller="About" asp-action="Index">About &amp; History</a></li>
            <li><a asp-controller="Staff" asp-action="Index">Academic Staff</a></li>
            <li><a asp-controller="Courses" asp-action="Index">Courses</a></li>
            <li><a asp-controller="Houses" asp-action="Index">Houses</a></li>
            <li><a asp-controller="Announcements" asp-action="Index">Announcements</a></li>
            <li><a asp-controller="Events" asp-action="Index">Events</a></li>
            <li><a asp-controller="Admissions" asp-action="Index">Admissions</a></li>
          </ul>
        </div>

        <div class="col-md-4">
          <h6 class="footer-heading">Contact</h6>
          <p class="footer-text">
            <i class="bi bi-envelope me-2"></i>headmaster@hogwarts.wiz<br />
            <i class="bi bi-geo-alt me-2"></i>Scottish Highlands, Scotland
          </p>
        </div>

      </div>
      <hr class="footer-divider" />
      <p class="footer-copy text-center mb-0">
        &copy; Hogwarts School of Witchcraft and Wizardry &nbsp;&middot;&nbsp;
        <a href="/admin/login" class="footer-admin-link">Admin</a>
      </p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/main.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
