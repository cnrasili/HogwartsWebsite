@model SchoolEvent
@{
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
  <div class="col-lg-6">
    <p class="mb-1 text-muted">Are you sure you want to delete this event?</p>
    <div class="past-headmaster-card mb-4">
      <p class="fw-bold mb-1">@Model.Title</p>
      <p class="text-muted small mb-0">@Model.Location &mdash; @Model.EventDate.ToString("dd MMM yyyy")</p>
    </div>
    <div class="d-flex gap-2">
      <form asp-controller="AdminEvents" asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="admin-btn admin-btn--danger">Yes, Delete</button>
      </form>
      <a href="/admin/events" class="admin-btn admin-btn--secondary">Cancel</a>
    </div>
  </div>
</div>
