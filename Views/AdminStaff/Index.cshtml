@model IEnumerable<StaffMember>
@{
    Layout = "_AdminLayout";
}

<div class="admin-section-header">
  <span></span>
  <a href="/admin/staff/create" class="admin-btn admin-btn--primary">
    <i class="bi bi-plus me-1"></i>New Staff Member
  </a>
</div>

<div class="table-responsive">
  <table class="table table-bordered table-hover admin-table">
    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th style="width:100px">Title</th>
        <th>Subject</th>
        <th style="width:90px">Role</th>
        <th style="width:130px">Actions</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var item in Model)
      {
        <tr>
          <td>@item.FullName</td>
          <td>@item.Title</td>
          <td>@(item.Subject ?? "—")</td>
          <td>@(item.IsHeadmaster ? "Headmaster" : "Staff")</td>
          <td>
            <a href="/admin/staff/edit/@item.Id" class="admin-btn admin-btn--secondary me-1">Edit</a>
            <a href="/admin/staff/delete/@item.Id" class="admin-btn admin-btn--danger">Delete</a>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>
