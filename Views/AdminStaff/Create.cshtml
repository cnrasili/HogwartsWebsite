@model StaffMember
@{
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
  <div class="col-lg-7">
    <form asp-controller="AdminStaff" asp-action="Create" method="post" enctype="multipart/form-data">
      <div class="row mb-3">
        <div class="col-md-8">
          <label asp-for="FullName" class="form-label"></label>
          <input asp-for="FullName" class="form-control" />
          <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
          <label asp-for="Title" class="form-label"></label>
          <input asp-for="Title" class="form-control" placeholder="Professor / Madam" />
        </div>
      </div>
      <div class="mb-3">
        <label asp-for="Subject" class="form-label"></label>
        <input asp-for="Subject" class="form-control" placeholder="Optional" />
      </div>
      <div class="mb-3">
        <label asp-for="Bio" class="form-label"></label>
        <textarea asp-for="Bio" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Bio" class="text-danger small"></span>
      </div>
      <div class="mb-3">
        <label class="form-label">Photo</label>
        <input type="file" name="photo" class="form-control" accept="image/*" />
        <div class="form-text">Upload a photo or leave empty.</div>
      </div>
      <div class="mb-4">
        <div class="form-check">
          <input asp-for="IsHeadmaster" class="form-check-input" />
          <label asp-for="IsHeadmaster" class="form-check-label">Is Headmaster</label>
        </div>
      </div>
      <div class="d-flex gap-2">
        <button type="submit" class="admin-btn admin-btn--primary">Save</button>
        <a href="/admin/staff" class="admin-btn admin-btn--secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
