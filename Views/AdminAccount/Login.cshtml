@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login — Hogwarts</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body class="admin-body">
  <div class="admin-login-page">
    <div class="admin-login-card">
      <img src="~/assets/images/hogwarts-crest.png" alt="Hogwarts" class="admin-login-logo" />
      <h1 class="admin-login-title">Hogwarts</h1>
      <p class="admin-login-subtitle">Administration Panel</p>

      @if (ViewData["Error"] != null)
      {
        <div class="alert alert-danger py-2 mb-3" role="alert">@ViewData["Error"]</div>
      }

      <form method="post" action="/admin/login">
        @Html.AntiForgeryToken()
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input type="text" id="username" name="username" class="form-control" autocomplete="username" required />
        </div>
        <div class="mb-4">
          <label for="password" class="form-label">Password</label>
          <input type="password" id="password" name="password" class="form-control" autocomplete="current-password" required />
        </div>
        <button type="submit" class="admin-btn admin-btn--primary w-100">Sign In</button>
      </form>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
